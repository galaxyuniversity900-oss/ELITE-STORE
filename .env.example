# Copy to .env before starting local infrastructure.
POSTGRES_DB=mes_store
POSTGRES_USER=mes_store
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-with-another-long-random-password
REDIS_PORT=6379

# Used by Prisma CLI and application services.
DATABASE_URL=postgresql://mes_store:replace-with-a-long-random-password@localhost:5432/mes_store?schema=public
REDIS_URL=redis://:replace-with-another-long-random-password@localhost:6379
