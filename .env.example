# Copy to .env. Generate unique random secrets; never commit the real .env.
# Published container ports bind to loopback by default. Override only behind a firewall/reverse proxy.
HOST_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=mes_store
POSTGRES_USER=mes_store
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_secret
POSTGRES_PORT=5432

REDIS_PASSWORD=replace_with_another_long_random_alphanumeric_secret
REDIS_PORT=6379

DATABASE_URL=postgresql://mes_store:replace_with_a_long_random_alphanumeric_secret@localhost:5432/mes_store?schema=public
REDIS_URL=redis://:replace_with_another_long_random_alphanumeric_secret@localhost:6379

# Required for signed admin access tokens; use at least 32 random bytes.
JWT_SECRET=
# Optional first-run administrator bootstrap. Set both values or neither.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

DEMO_COMMERCE_ENABLED=false
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_STOREFRONT_URL=https://galaxyuniversity900-oss.github.io/ELITE-STORE/ELITE.html

# Transactional order notification outbox. Set secrets only in the API deployment secret store.
WHATSAPP_ORDER_RECIPIENT=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_ORDER_TEMPLATE_NAME=
WHATSAPP_ORDER_TEMPLATE_LANGUAGE=ar
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

ORDER_NOTIFICATION_EMAIL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Order PII retention is owner/legal-policy controlled; leave unset until approved.
ORDER_PII_RETENTION_DAYS=
# Required only for explicit destructive execution of the retention script.
ORDER_PII_RETENTION_CONFIRM=

# Admin Outbox monitoring thresholds (alerts remain inside the authenticated admin UI).
OUTBOX_ALERT_PENDING_BACKLOG=50
OUTBOX_ALERT_DEAD_COUNT=1
OUTBOX_ALERT_FAILURE_RATE_PERCENT=10
OUTBOX_ALERT_SEND_P95_MS=30000
OUTBOX_ALERT_OLDEST_PENDING_SECONDS=900
