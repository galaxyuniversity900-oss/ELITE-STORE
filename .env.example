# Copy this file to .env. Use long URL-safe alphanumeric secrets.
POSTGRES_DB=mes_store
POSTGRES_USER=mes_store
POSTGRES_PASSWORD=replace_with_a_long_random_alphanumeric_secret
POSTGRES_PORT=5432

REDIS_PASSWORD=replace_with_another_long_random_alphanumeric_secret
REDIS_PORT=6379

DATABASE_URL=postgresql://mes_store:replace_with_a_long_random_alphanumeric_secret@localhost:5432/mes_store?schema=public
REDIS_URL=redis://:replace_with_another_long_random_alphanumeric_secret@localhost:6379

API_PORT=4000
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_STOREFRONT_URL=https://galaxyuniversity900-oss.github.io/ELITE-STORE/ELITE.html
