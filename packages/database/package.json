{
  "name": "@mes-store/database",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Prisma database schema and generated client",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "prisma generate --schema=../../prisma/schema.prisma",
    "validate": "prisma validate --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
