{
  "name": "mes-store-platform",
  "version": "1.0.0",
  "private": true,
  "description": "MES STORE commerce platform monorepo",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "npm run dev --workspace=@mes-store/web",
    "dev:api": "npm run dev --workspace=@mes-store/api",
    "dev:admin": "npm run dev --workspace=@mes-store/admin",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verify:product-image-lab": "node scripts/verify-product-image-lab.mjs",
    "seo:static": "node scripts/generate-static-seo.mjs --output _site",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:seed": "node scripts/seed-products.mjs",
    "db:validate": "prisma validate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "notifications:providers": "node scripts/verify-notification-providers.mjs",
    "notifications:providers:live": "node scripts/verify-notification-providers.mjs --send-live",
    "qa:commerce:e2e": "node scripts/verify-commerce-e2e.mjs",
    "qa:storefront:load": "docker run --rm --network host -v \"$PWD/scripts/load:/scripts:ro\" grafana/k6:0.56.0 run --env BASE_URL=http://127.0.0.1:4000/api /scripts/storefront-load.js",
    "qa:postgres:restore": "bash scripts/verify-postgres-restore.sh",
    "verify:motion-embeds": "node --check assets/js/mes-motion-embed.js && node scripts/verify-motion-embeds.mjs",
    "privacy:orders:retention": "node scripts/retention/redact-order-pii.mjs"
  },
  "devDependencies": {
    "prisma": "6.19.0",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@prisma/client": "6.19.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.8.0"
  }
}
