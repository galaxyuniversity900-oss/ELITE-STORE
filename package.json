{
  "name": "mes-store-platform",
  "version": "1.0.0",
  "private": true,
  "description": "MES STORE commerce platform monorepo",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "npm run dev --workspace=@mes-store/web",
    "dev:api": "npm run dev --workspace=@mes-store/api",
    "dev:admin": "npm run dev --workspace=@mes-store/admin",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verify:product-image-lab": "node scripts/verify-product-image-lab.mjs",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:seed": "node scripts/seed-products.mjs",
    "db:validate": "prisma validate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.8.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
