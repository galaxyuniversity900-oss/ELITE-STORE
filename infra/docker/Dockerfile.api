FROM node:22-alpine
WORKDIR /app
COPY package.json turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY prisma ./prisma
COPY data ./data
COPY scripts ./scripts
RUN npm install --no-audit --no-fund
RUN npm run db:generate
RUN npm run build --workspace=@mes-store/api
ENV NODE_ENV=production
EXPOSE 4000
CMD ["npm", "run", "start", "--workspace=@mes-store/api"]
