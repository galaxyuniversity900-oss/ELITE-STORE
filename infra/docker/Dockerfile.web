FROM node:22-alpine
WORKDIR /app
ARG NEXT_PUBLIC_WEB_URL=
ENV NEXT_PUBLIC_WEB_URL=$NEXT_PUBLIC_WEB_URL
ARG NEXT_PUBLIC_STOREFRONT_URL=https://galaxyuniversity900-oss.github.io/ELITE-STORE/ELITE.html
ENV NEXT_PUBLIC_STOREFRONT_URL=$NEXT_PUBLIC_STOREFRONT_URL
COPY package.json turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY prisma ./prisma
RUN npm install --no-audit --no-fund
RUN npm run build --workspace=@mes-store/web
ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "run", "start", "--workspace=@mes-store/web"]
