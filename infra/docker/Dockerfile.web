FROM node:22-alpine
WORKDIR /app
COPY package.json turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY prisma ./prisma
RUN npm install --no-audit --no-fund
RUN npm run build --workspace=@mes-store/web
ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "run", "start", "--workspace=@mes-store/web"]
